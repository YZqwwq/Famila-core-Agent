# Copy to .env. Values are applied to this identity's persisted model configuration.
FAMILA_DATA_DIR=./.famila
# hdsi: native HDSI conversation engine; langgraph: original execution engine.
FAMILA_CHAT_ENGINE=hdsi
# native preserves per-turn narrative/state updates; fast is experimental and can skip them.
FAMILA_HDSI_MODE=native
# Outer scene-action harness (native mode only); time and durable personal notes.
FAMILA_HDSI_ACTIONS=1
# wttr: 3-day forecast with 3-hour time points; open-meteo: 7-day daily forecast.
FAMILA_WEATHER_PROVIDER=wttr
# Public search uses DASHSCOPE_API_KEY or an exact
# dashscope.aliyuncs.com main-model credential; defaults to qwen-plus.
# DASHSCOPE_API_KEY=
# DASHSCOPE_WEB_SEARCH_MODEL=qwen-plus
FAMILA_HOST=127.0.0.1
FAMILA_PORT=4317
# Required for a non-loopback host; optional for localhost.
# FAMILA_API_TOKEN=

FAMILA_MODEL_VENDOR=openai
FAMILA_MODEL_API_KEY=replace-with-your-key
FAMILA_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FAMILA_MODEL=qwen-plus
FAMILA_USE_RESPONSES_API=false
# Defaults to the main model unless these are set.
# FAMILA_QUICK_MODEL=
# FAMILA_QUICK_API_KEY=
# FAMILA_QUICK_BASE_URL=
# FAMILA_QUICK_VENDOR=openai

# Optional independent DashScope search credentials (needed with other main providers).
# DASHSCOPE_API_KEY=
# DASHSCOPE_WEB_SEARCH_MODEL=qwen-plus
## Optional experimental tone demonstrations; leave unset for the neutral baseline.
# FAMILA_CHAT_TONE=examples

# HDSI PostgreSQL. Local development defaults to test. Select prod explicitly for deployment.
FAMILA_DB_ENV=test
FAMILA_PG_CA_FILE=
FAMILA_TEST_PG_HOST=
FAMILA_TEST_PG_PORT=5432
FAMILA_TEST_PG_DATABASE=famila_test
FAMILA_TEST_PG_USER=famila_test_app
FAMILA_TEST_PG_PASSWORD=
FAMILA_PROD_PG_HOST=
FAMILA_PROD_PG_PORT=5432
FAMILA_PROD_PG_DATABASE=famila_prod
FAMILA_PROD_PG_USER=famila_prod_app
FAMILA_PROD_PG_PASSWORD=

# QQ private-chat adapter runs separately from the HTTP service.
# FAMILA_QQ_ID=
# FAMILA_QQ_SECRET=
# FAMILA_QQ_BIND_CODE=
